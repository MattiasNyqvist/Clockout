<div class="wheel">
    <div class="wheel-box" aria-live="polite">
        <div class="wheel-item">@Prev</div>
        <div class="wheel-item cur">@Current</div>
        <div class="wheel-item">@Next</div>
    </div>
    <div class="wheel-side">
        <button type="button" class="wheel-btn" aria-label="@Label upp" @onclick="OnUp">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"/></svg>
        </button>
        <span class="wheel-label">@Label</span>
        <button type="button" class="wheel-btn" aria-label="@Label ned" @onclick="OnDown">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>
    </div>
</div>

@code {
    [Parameter] public string Prev { get; set; } = "";
    [Parameter, EditorRequired] public string Current { get; set; } = "";
    [Parameter] public string Next { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public EventCallback OnUp { get; set; }
    [Parameter] public EventCallback OnDown { get; set; }
}
